# Cloudflare Pages headers
# https://developers.cloudflare.com/pages/configuration/headers/

# Required for SharedArrayBuffer (WASM threads in onnxruntime-web)
# Without these, ONNX Runtime Web falls back to single-threaded WASM
/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  Cross-Origin-Resource-Policy: cross-origin
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Short cache for unbusted assets (no content-hash filenames yet).
# Cloudflare also caches at the edge — `must-revalidate` lets the browser
# pick up new deploys quickly while the edge still serves fast.
/*.js
  Cache-Control: public, max-age=0, must-revalidate

/*.css
  Cache-Control: public, max-age=0, must-revalidate

# HTML always fresh
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Index always fresh
/
  Cache-Control: public, max-age=0, must-revalidate
